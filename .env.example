# mRNA Vaccine Intelligence & Protection (VIP)
#
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env      (macOS / Linux / Git Bash)
#     Copy-Item .env.example .env   (Windows PowerShell)
#
# `.env` is listed in .gitignore and must never be committed.
# This file contains variable NAMES ONLY - no real credentials.
# Only LLM_API_KEY is a secret; every other value is a non-secret setting.

# --- Required: LLM provider credential (Module 4 only) -------------------
# Copy the key from your provider dashboard and paste it into `.env`.
LLM_API_KEY=

# --- Optional: non-secret runtime settings -------------------------------
# Leave blank to use the defaults declared in src/config.py.

# Provider choice: openai, anthropic, or any OpenAI-compatible endpoint.
#LLM_PROVIDER=openai

# Model name used for report generation.
#LLM_MODEL=gpt-4o-mini

# Base URL for OpenAI-compatible or Azure OpenAI endpoints.
#LLM_BASE_URL=

# Chunking / embedding overrides for Module 3. Changing these changes the
# vector index and invalidates the persisted ChromaDB collection.
#EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
#CHUNK_SIZE_CHARS=1500
#CHUNK_OVERLAP_CHARS=250