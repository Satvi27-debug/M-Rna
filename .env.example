# mRNA Vaccine Intelligence & Protection (VIP)
# ---------------------------------------------------------------------------
# Copy this file to `.env` in the project root and fill in the values below.
#   Copy-Item .env.example .env        # Windows PowerShell
#   cp .env.example .env              # macOS / Linux / Git Bash
#
# `.env` is gitignored and must NEVER be committed. This file contains variable
# names and safe defaults only - no real credentials. During deployment, create
# the real `.env` separately; do not bake a key into source control.
# ---------------------------------------------------------------------------

# --- Required for live LLM report generation (Module 4) --------------------
# Paste your provider key after the equals sign. Read at call time only.
LLM_API_KEY=

# --- Optional: LLM runtime settings ---------------------------------------
# Provider label used in error messages. The client itself is OpenAI-compatible.
LLM_PROVIDER=openai

# Model identifier passed to ChatOpenAI.
LLM_MODEL=gpt-4o-mini

# Leave empty for the official OpenAI endpoint. Set for OpenRouter, Groq,
# Azure OpenAI, or a local gateway (an OpenAI-compatible base URL).
LLM_BASE_URL=

# Fallback credential name. Only needed if you already export this instead of
# LLM_API_KEY. Leave empty unless your environment uses the OpenAI convention.
OPENAI_API_KEY=

# --- Optional: dashboard server (Module 6) --------------------------------
# Bind address. Keep 127.0.0.1 unless you intentionally expose the interface.
DASHBOARD_HOST=127.0.0.1

# Bind port. CLI `--port` overrides this value.
DASHBOARD_PORT=8000

# --- Optional: Hugging Face / offline operation ---------------------------
# Uncomment to stop sentence-transformers from contacting the Hub at runtime.
# The embedding model is cached locally after the first `python -m src.rag.ingest`.
#HF_HUB_OFFLINE=1
